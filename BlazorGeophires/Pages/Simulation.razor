<h3>Simulation Parameters</h3>

<MudNumericField T="int"
                 @bind-Value="Parms.timestepsperyear"
                 Label="Time steps per year"
                 Variant="Variant.Outlined"
                 Min="1"
                 Max="100"
                 Immediate="true" />

<MudSelect T="int" Label="End-Use Option"
           @bind-Value="Parms.enduseoption"
           Variant="Variant.Outlined">
    <MudSelectItem Value="1">Electricity</MudSelectItem>
    <MudSelectItem Value="2">Direct-Use Heat</MudSelectItem>
    <MudSelectItem Value="31">Cogeneration Topping Cycle — Heat sales considered as extra income</MudSelectItem>
    <MudSelectItem Value="32">Cogeneration Topping Cycle — Electricity sales considered as extra income</MudSelectItem>
    <MudSelectItem Value="41">Cogeneration Bottoming Cycle — Heat sales considered as extra income</MudSelectItem>
    <MudSelectItem Value="42">Cogeneration Bottoming Cycle — Electricity sales considered as extra income</MudSelectItem>
    <MudSelectItem Value="51">Cogeneration Parallel Cycle — Heat sales considered as extra income</MudSelectItem>
    <MudSelectItem Value="52">Cogeneration Parallel Cycle — Electricity sales considered as extra income</MudSelectItem>
</MudSelect>

<MudSelect T="int?"
           @bind-Value="Parms.pptype"
           Label="Power plant type"
           Variant="Variant.Outlined"
           Clearable="true"
           Placeholder="(none)">
    @if (PowerPlantTypes != null)
    {
        var counter = 1;
        foreach (var type in PowerPlantTypes)
        {
            <MudSelectItem Value="@((int?)counter)">@type</MudSelectItem>
            counter++;
        }
    }
</MudSelect>

<MudNumericField T="double"
                 @bind-Value="Parms.projectlatitude"
                 Label="Project Latitude"
                 HelperText="Latitude of the project location (-90 to 90)"
                 Variant="Variant.Outlined"
                 Min="-90.0"
                 Max="90.0"
                 Immediate="true" />

<MudNumericField T="double"
                 @bind-Value="Parms.projectlongitude"
                 Label="Project Longitude"
                 HelperText="Longitude of the project location (-180 to 180)"
                 Variant="Variant.Outlined"
                 Min="-180.0"
                 Max="180.0"
                 Immediate="true" />

@code {
    [Parameter] public SimulationParameters Parms { get; set; }
    private readonly string[] PowerPlantTypes =
    {
        "Subcritical ORC",
        "Supercritical ORC",
        "Single-flash",
        "Double-flash"
    };

    protected override void OnParametersSet()
    {
        Console.WriteLine($"Simulation Parameters received: End use option ={Parms.enduseoption}");
    }
}